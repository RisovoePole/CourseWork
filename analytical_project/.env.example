# =====================
# APP SETTINGS
# =====================
APP_NAME=python_app
APP_PORT=5551

# =====================
# DATABASE SETTINGS
# =====================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# Полный URL подключения к БД для SQLAlchemy.
DATABASE_URL=postgresql://postgres:postgres@db:5432/mydb

# =====================
# ALGORITHM SETTINGS
# =====================
# Количество дисциплин, из которых строится пространство вариантов.
ALGORITHM_DISCIPLINE_COUNT=2
# Количество дней/слотов недели по оси weekday.
ALGORITHM_WEEKDAY_COUNT=3
# Количество временных слотов в каждом дне.
ALGORITHM_TIMESLOT_COUNT=3
# Количество аудиторий, доступных для постановки пары.
ALGORITHM_AUDIENCE_COUNT=2
# Максимальное число пар в одном расписании.
ALGORITHM_MAX_PAIRS_PER_WEEK=5

# Ограничение правила: максимум пар в одном дне.
ALGORITHM_MAX_PAIRS_PER_DAY=2

# Размер расписания, который будет использоваться в запусках из src/main.py.
ALGORITHM_RUN_MAX_PAIRS=1
